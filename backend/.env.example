# Database (update db.js to use these when configured)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=test_db
# PGUSER=postgres
# PGPASSWORD=your_password

JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Stripe (get keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Appointment booking fee in cents (5000 = $50.00)
APPOINTMENT_BOOKING_FEE_CENTS=5000
PAYMENT_CURRENCY=usd

# Email (Nodemailer) — e.g. Gmail SMTP or Mailtrap for testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=noreply@carlislepetcare.com
EMAIL_FROM_NAME=Carlisle Pet Care
